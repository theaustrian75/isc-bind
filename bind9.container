# /etc/containers/systemd/bind9.container
# Quadlet unit — after editing: systemctl daemon-reload && systemctl restart bind9
[Unit]
Description=ISC BIND 9 DNS
After=network-online.target
Wants=network-online.target

[Container]
# Replace with an immutable release tag or manifest digest before installing.
Image=ghcr.io/theaustrian75/isc-bind/bind9@sha256:REPLACE_WITH_MANIFEST_DIGEST
ContainerName=bind9
# Match host UID/GID to volume ownership. Change Environment BIND_UID/BIND_GID
# and Tmpfs uid=/gid= together when remapping (defaults 100/101).
User=0
Group=0
Environment=BIND_UID=100
Environment=BIND_GID=101
Environment=TZ=America/New_York
Environment=SKIP_CONFIG_TEST=false
Environment=BIND_HEALTHCHECK_SERVER=127.0.0.1
Environment=BIND_HEALTHCHECK_PORT=53
# Host networking is typical for authoritative / recursive DNS on :53.
Network=host
Volume=/srv/bind/etc:/etc/bind:ro,Z
Volume=/srv/bind/certs:/etc/bind/certs:ro,Z
Volume=bind9-cache.volume:/var/cache/bind
Volume=bind9-data.volume:/var/lib/bind
Volume=bind9-log.volume:/var/log/bind
Tmpfs=/run/named:rw,size=16m,uid=100,gid=101,mode=0750
Tmpfs=/tmp:rw,size=16m,mode=1777
ReadOnly=true
# No NoNewPrivileges: entrypoint needs ambient NET_BIND_SERVICE after dropping
# to BIND_UID so named can bind UDP/TCP 53.
DropCapability=all
AddCapability=CAP_NET_BIND_SERVICE
AddCapability=CAP_CHOWN
AddCapability=CAP_SETUID
AddCapability=CAP_SETGID
AddCapability=CAP_DAC_OVERRIDE
PidsLimit=256
Memory=512m
StopTimeout=15
HealthOnFailure=restart

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
