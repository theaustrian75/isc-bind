# Private key material — never commit
*.key
*.p12
*.pfx
*.pem
*.crt
!*.example.crt

# BIND DNSSEC key pairs (K<name>+<alg>+<id>)
K*.key
K*.private
K*.state
*.private

# TSIG / session / control channel
rndc.key
*.tsig
session.key

# Dynamic DNS update secrets (often plain .conf with inline HMAC secrets)
keys.conf
**/keys.conf
named.conf.keys
**/named.conf.keys
named.conf.ddns
**/named.conf.ddns
ddns.key
dhcp-ddns.key
tsig.key
*.keyfile
nsupdate.keys

# TLS / DoT / DoH material (runtime mounts)
/tls/
*.csr

# Local env with registry credentials / overrides
.env
.env.*
!.env.example

# Site-specific runtime config / certs (keep examples + placeholders tracked)
/config/bind/**
!/config/bind/.gitignore
!/config/bind/README.md
!/config/examples/
!/config/examples/**
/certs/**
!/certs/bind/
!/certs/bind/.gitignore
!/certs/bind/README.md
!/config/examples/certs/
!/config/examples/certs/**

# Local / editor
.DS_Store
*.swp
*~
*.log

# Build artifacts
*.tar
*.tar.gz
