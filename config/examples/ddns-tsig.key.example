# Example TSIG key for Kea / nsupdate → BIND dynamic DNS.
# Copy to a gitignored path (e.g. config/bind/ddns-tsig.key) and replace the secret.
# Generate a secret with:
#   tsig-keygen -a hmac-sha256 dhcp-ddns
# or:
#   openssl rand -base64 32

key "dhcp-ddns" {
	algorithm hmac-sha256;
	secret "REPLACE_WITH_BASE64_TSIG_SECRET=";
};
