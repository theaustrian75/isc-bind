# Used by CI compose validation and as a local starting point.
# Point BIND_CONFIG_DIR at a directory with named.conf (TSIG/DDNS keys ok here; gitignored).
# Point BIND_CERT_DIR at fullchain/privkey (or similar) for DoT/DoH — never commit those.

BIND9_IMAGE=isc-bind/bind9:test
BIND9_CONTAINER_NAME=bind9-env-test
BIND_CONFIG_DIR=/tmp/bind-config-test
BIND_CERT_DIR=/tmp/bind-cert-test
# Process identity after privilege drop (also passed as image build-args).
# Use any non-zero host UID/GID that owns your config/data volumes.
BIND_UID=12345
BIND_GID=12346
TZ=UTC
SKIP_CONFIG_TEST=false
# Empty BIND_LOG_FILE = log to stderr. Example: /var/log/bind/default.log
BIND_LOG_FILE=
BIND_CONFIG=/etc/bind/named.conf
# dig-based healthcheck (CHAOS hostname.bind by default)
BIND_HEALTHCHECK_SERVER=127.0.0.1
BIND_HEALTHCHECK_PORT=53
BIND_HEALTHCHECK_QNAME=hostname.bind
BIND_HEALTHCHECK_QTYPE=TXT
BIND_HEALTHCHECK_CLASS=CH
