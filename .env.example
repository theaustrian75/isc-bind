# Copy to .env (gitignored) and adjust for your registry.
# Auth uses a Podman secret — never put the password here.
#
#   printf '%s' 'YOUR_PASSWORD' | podman secret create dn-registry-password -
#   # or: podman secret create dn-registry-password ./password.txt

REGISTRY=registry.klausk.xyz:8443
REPOSITORY=repositories/dragonsnest
REGISTRY_USER=dn-registry
PODMAN_SECRET=dn-registry-password
TAG=latest
