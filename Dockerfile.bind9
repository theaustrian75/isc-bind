# Alpine-based ISC BIND 9 (multi-arch: amd64/arm64)
FROM alpine:3.24.1

LABEL org.opencontainers.image.authors="admin@klausk.xyz" \
      org.opencontainers.image.title="bind9" \
      org.opencontainers.image.description="ISC BIND 9 DNS (Do53 / DoT / DoH capable)"

# Host-side matching user (example):
#   addgroup --gid 20002 podman-bind && adduser --uid 20002 --ingroup podman-bind \
#     --home /tmp --no-create-home --disabled-password --disabled-login \
#     --comment "Podman - ISC Bind9" podman-bind

ARG BIND_UID=20002
ARG BIND_GID=20002

ENV BIND_UID="${BIND_UID}" \
    BIND_GID="${BIND_GID}" \
    TZ=UTC \
    SKIP_CONFIG_TEST=false \
    BIND_CONFIG=/etc/bind/named.conf

RUN apk add --no-cache \
        bind \
        bind-tools \
        bind-plugins \
        bind-dnssec-root \
        bind-dnssec-tools \
        tzdata \
        util-linux \
    && apk add --no-cache --virtual .account-tools shadow \
    && if ! awk -F: -v gid="${BIND_GID}" '$3 == gid { found = 1 } END { exit !found }' /etc/group; then \
         groupmod -g "${BIND_GID}" named; \
       fi \
    && usermod -u "${BIND_UID}" -g "${BIND_GID}" named \
    && test "$(id -u named)" = "${BIND_UID}" \
    && test "$(id -g named)" = "${BIND_GID}" \
    && apk del .account-tools \
    && mkdir -p /etc/bind /var/cache/bind /var/lib/bind /var/log/bind /run/named \
    && chown -R "${BIND_UID}:${BIND_GID}" /var/cache/bind /var/lib/bind /var/log/bind /run/named \
    && chmod 0750 /run/named

COPY --chmod=0755 entrypoint.sh /usr/local/bin/entrypoint.sh
COPY --chmod=0755 healthcheck.sh /usr/local/bin/healthcheck.sh

# named.conf, TSIG keys, and optional TLS material are mounted at runtime —
# never bake secrets into the image.
VOLUME [ "/etc/bind", "/var/cache/bind", "/var/lib/bind", "/var/log/bind", "/run/named" ]

EXPOSE 53/udp 53/tcp 853/tcp 443/tcp 953/tcp

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["/usr/local/bin/healthcheck.sh"]

# Start as root so the entrypoint can chown runtime dirs, then drop via setpriv.
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
